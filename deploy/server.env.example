# Keep the real file outside the checkout at:
# /home/apps/.config/telegram-ping-mcp/server.env (mode 0600)
TELEGRAM_BOT_TOKEN=
MCP_AUTH_TOKEN=
DATABASE_PATH=/srv/apps/telegram-ping-mcp/data/state.sqlite3
LINK_TTL_SECONDS=900
ALLOWED_GROUP_CHAT_IDS=
# Add only the selected public hostname after configuring HTTPS ingress.
MCP_ALLOWED_HOSTS=127.0.0.1:18007,localhost:18007
POLLING_ENABLED=true
MAX_ATTACHMENT_BYTES=104857600
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_LOCAL_FILES_ROOT=
