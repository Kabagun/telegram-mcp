# Пример настроек. Подставьте локальные значения и не коммитьте файл .env.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
MCP_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=data/telegram-ping.sqlite3
LINK_TTL_SECONDS=900
ALLOWED_GROUP_CHAT_IDS=
MCP_ALLOWED_HOSTS=
POLLING_ENABLED=true
